#!/usr/bin/python3
"""Collect Kiro CLI monthly credit usage into a display-ready JSON record.

Kiro CLI stores its active login and CodeWhisperer profile in its local
SQLite database. This collector reuses that session to call the same
GetUsageLimits operation shown by Kiro CLI's /usage panel.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "kiro"
AGENT_NAME = "Kiro CLI"
AUTH_HELP = "Run `kiro-cli login` to restore Kiro usage."
PROBE_MIN_INTERVAL_SECONDS = 15
TOKEN_KEYS = ("kirocli:odic:token", "kirocli:external-idp:token")


def expand_path(value: str) -> Path:
  return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def default_db_path() -> Path:
  data = os.environ.get("XDG_DATA_HOME")
  base = expand_path(data) if data else expand_path("~/.local/share")
  return base / "kiro-cli" / "data.sqlite3"


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    if time.time() - path.stat().st_mtime <= max_age_seconds:
      data = json.loads(path.read_text(encoding="utf-8"))
      return data if isinstance(data, dict) else None
  except Exception:
    return None
  return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def sqlite_json(conn: sqlite3.Connection, table: str, key: str) -> dict[str, Any] | None:
  try:
    row = conn.execute(f"SELECT value FROM {table} WHERE key = ?", (key,)).fetchone()
    if not row:
      return None
    raw = row[0]
    if isinstance(raw, bytes):
      raw = raw.decode("utf-8", errors="replace")
    data = json.loads(str(raw))
    return data if isinstance(data, dict) else None
  except Exception:
    return None


def read_auth(db_path: Path) -> tuple[str, str]:
  if not db_path.is_file():
    raise FileNotFoundError(str(db_path))
  conn = sqlite3.connect(db_path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  try:
    profile = sqlite_json(conn, "state", "api.codewhisperer.profile") or {}
    profile_arn = str(profile.get("arn") or "").strip()
    token = ""
    for key in TOKEN_KEYS:
      auth = sqlite_json(conn, "auth_kv", key) or {}
      token = str(auth.get("access_token") or auth.get("accessToken") or "").strip()
      if token:
        break
  finally:
    conn.close()
  if not token or not profile_arn:
    raise ValueError("missing Kiro login or profile")
  return token, profile_arn


def refresh_login() -> None:
  executable = os.environ.get("KIRO_CLI_BIN") or shutil.which("kiro-cli")
  if not executable:
    return
  try:
    subprocess.run(
      [executable, "whoami", "--format", "json"],
      stdin=subprocess.DEVNULL,
      stdout=subprocess.DEVNULL,
      stderr=subprocess.DEVNULL,
      timeout=20,
      check=False,
    )
  except Exception:
    pass


def region_from_profile(profile_arn: str) -> str:
  parts = profile_arn.split(":")
  return parts[3] if len(parts) > 4 and parts[3] else "us-east-1"


def endpoint_for(profile_arn: str) -> str:
  override = str(os.environ.get("KIRO_USAGE_URL") or "").strip()
  if override:
    return override
  return f"https://q.{region_from_profile(profile_arn)}.amazonaws.com"


def usage_request(token: str, profile_arn: str) -> dict[str, Any]:
  body = json.dumps({"profileArn": profile_arn, "origin": "KIRO_CLI"}).encode("utf-8")
  request = urllib.request.Request(
    endpoint_for(profile_arn),
    data=body,
    headers={
      "Authorization": f"Bearer {token}",
      "Content-Type": "application/x-amz-json-1.0",
      "X-Amz-Target": "AmazonCodeWhispererService.GetUsageLimits",
      "User-Agent": "rafa.agents/1.0 KiroCLIUsageCollector",
    },
    method="POST",
  )
  with urllib.request.urlopen(request, timeout=12) as response:
    payload = json.loads(response.read().decode("utf-8", errors="replace"))
  if not isinstance(payload, dict):
    raise ValueError("unexpected usage response")
  return payload


def request_with_refresh(db_path: Path, token: str, profile_arn: str) -> dict[str, Any]:
  try:
    return usage_request(token, profile_arn)
  except urllib.error.HTTPError as error:
    if error.code not in (401, 403):
      raise
  refresh_login()
  fresh_token, fresh_profile = read_auth(db_path)
  return usage_request(fresh_token, fresh_profile)


def number(value: Any, fallback: float = 0.0) -> float:
  try:
    parsed = float(value)
    return parsed if parsed == parsed else fallback
  except Exception:
    return fallback


def reset_at(value: Any) -> str:
  stamp = number(value, -1)
  if stamp <= 0:
    return ""
  if stamp > 10_000_000_000:
    stamp /= 1000
  try:
    return dt.datetime.fromtimestamp(stamp, tz=dt.timezone.utc).isoformat()
  except Exception:
    return ""


def plan_label(payload: dict[str, Any]) -> str:
  subscription = payload.get("subscriptionInfo")
  if not isinstance(subscription, dict):
    return "Kiro"
  raw = str(subscription.get("subscriptionTitle") or "Kiro").strip()
  if raw.upper().startswith("KIRO "):
    return "Kiro " + raw[5:].title()
  return raw


def parse_limits(payload: dict[str, Any]) -> list[dict[str, Any]]:
  rows = payload.get("usageBreakdownList")
  if not isinstance(rows, list):
    return []
  fallback_reset = payload.get("nextDateReset")
  limits: list[dict[str, Any]] = []
  for row in rows:
    if not isinstance(row, dict):
      continue
    limit = number(row.get("usageLimitWithPrecision"), number(row.get("usageLimit")))
    used = number(row.get("currentUsageWithPrecision"), number(row.get("currentUsage")))
    if limit <= 0 or used < 0:
      continue
    name = str(row.get("displayNamePlural") or row.get("displayName") or "Credits").strip()
    limits.append(
      {
        "label": f"Monthly {name.lower()}",
        "title": name,
        "percent": used / limit,
        "resetsAt": reset_at(row.get("nextDateReset") or fallback_reset),
        "used": used,
        "limit": limit,
      }
    )
  return limits


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = dt.datetime.now(dt.timezone.utc)
  result = []
  for entry in entries:
    if not isinstance(entry, dict):
      continue
    raw = str(entry.get("resetsAt") or "")
    try:
      expires = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
      if expires.tzinfo is None:
        expires = expires.replace(tzinfo=dt.timezone.utc)
      if expires <= now:
        continue
    except Exception:
      pass
    result.append(entry)
  return result


def collect_limits(db_path: Path, token: str, profile_arn: str, force: bool) -> dict[str, Any]:
  account_key = hashlib.sha1(profile_arn.encode("utf-8")).hexdigest()[:16]
  cache_path = cache_root() / "kiro-limits.json"
  cached = read_fresh_json(cache_path, float("inf")) or {}
  fallback = usable_cached_limits(cached) if cached.get("accountKey") == account_key else []
  fetched_at = number(cached.get("fetchedAtMs")) / 1000

  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    return {"limits": fallback, "tierLabel": str(cached.get("plan") or "Kiro")}

  try:
    payload = request_with_refresh(db_path, token, profile_arn)
    limits = parse_limits(payload)
    if not limits:
      raise ValueError("usage response contained no plan limits")
    result = {"limits": limits, "tierLabel": plan_label(payload)}
    write_json(
      cache_path,
      {
        "fetchedAtMs": round(time.time() * 1000),
        "accountKey": account_key,
        "plan": result["tierLabel"],
        "limits": limits,
      },
    )
    return result
  except urllib.error.HTTPError as error:
    help_text = (
      "Kiro authentication failed. Run `kiro-cli login` again."
      if error.code in (401, 403)
      else f"Kiro usage endpoint returned status {error.code}."
    )
    transport = error.code >= 500 or error.code == 429
  except (urllib.error.URLError, TimeoutError):
    help_text = "Couldn't reach Kiro's usage endpoint. Retrying shortly."
    transport = True
  except Exception as error:
    help_text = f"Kiro usage could not be read: {error}"
    transport = False

  if fallback:
    result = {"limits": fallback, "tierLabel": str(cached.get("plan") or "Kiro")}
  else:
    result = {
      "limits": [],
      "tierLabel": "",
      "usageStatusText": "Kiro limits unavailable",
      "authHelpText": help_text,
    }
  if transport:
    result["retryAdvised"] = True
  return result


def waiting_record(message: str) -> dict[str, Any]:
  return {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": False,
    "hasLocalStats": False,
    "usageStatusText": "Waiting for auth",
    "authHelpText": message,
    "limits": [],
  }


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  db_path = expand_path(os.environ.get("KIRO_DB_PATH") or str(default_db_path()))
  try:
    token, profile_arn = read_auth(db_path)
  except Exception:
    refresh_login()
    try:
      token, profile_arn = read_auth(db_path)
    except Exception:
      print(json.dumps(waiting_record(AUTH_HELP), separators=(",", ":"), sort_keys=True))
      return 0

  collected = collect_limits(db_path, token, profile_arn, args.force)
  limits = collected.get("limits") or []
  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": len(limits) > 0,
    "hasLocalStats": False,
    "tierLabel": str(collected.get("tierLabel") or ""),
    "usageStatusText": str(collected.get("usageStatusText") or ""),
    "authHelpText": str(collected.get("authHelpText") or AUTH_HELP),
    "limits": limits,
  }
  if collected.get("retryAdvised"):
    record["retryAdvised"] = True
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
